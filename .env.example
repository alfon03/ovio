# Crea un proyecto gratuito en https://supabase.com/dashboard
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Project Settings → API → clave PUBLISHABLE (o anon legacy, nunca service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Opcional v2.0: Site Key PÚBLICA de Cloudflare Turnstile.
# No activar CAPTCHA en Supabase hasta publicar un despliegue con esta variable.
# Nunca colocar la Secret Key de Turnstile en VITE_.
# VITE_TURNSTILE_SITE_KEY=
